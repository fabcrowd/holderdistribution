# Copy to .env.local for local development. NEVER commit real values.
#
# ── Browser (Vite) — PUBLIC values only ─────────────────────────────────────
# Anything prefixed VITE_ is inlined into the client bundle and visible to every
# visitor. Do not put API keys, tokens or passwords here.
VITE_SITE_URL=https://holderdistribution.com
# Defaults to the production Supabase project when unset (anon/publishable key only).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Optional override for the holders-history JSON feed.
# VITE_HOLDER_HISTORY_URL=

# ── Netlify Function (netlify/functions/forensics-gate) — server-side only ──
# Set these in Netlify → Site settings → Environment variables, never in the repo.
# FORENSICS_PASSWORD=
# SUPABASE_SECRET_KEY=

# ── Data pipeline (scripts/, GitHub Actions) — server-side only ─────────────
# Secrets live encrypted in .env.enc; only the passphrase is a GitHub Actions
# secret. See scripts/encrypt-env.js / decrypt-env.js.
# ENV_PASSPHRASE=
