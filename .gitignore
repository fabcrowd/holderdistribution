# Holder indexer artifacts
holders.sqlite

# rebuild-history-from-logs.js's raw transfer cache (--resume). Local/session
# resumability only — real chain volume routinely exceeds GitHub's 100MB
# single-file push limit (Ethereum alone: 172MB), so this can never be
# committed. See .github/workflows/rebuild-holders-history.yml's comment.
data/rebuild-transfers-*.ndjson
# Per-window transfer fetches made by fill-history-gaps.js on a runner that has
# no local cache — scratch, regenerable, and never servable.
data/asof-window-*.ndjson
data/rebuild-transfers-*.json
